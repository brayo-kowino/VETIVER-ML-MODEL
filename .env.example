# ── Ollama Configuration ───────────────────────
# Base URL for the Ollama server (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# LLM model name (e.g. qwen2.5:3b or qwen2.5:1.5b for ~3x faster generation on CPU)
OLLAMA_LLM_MODEL=qwen2.5:3b

# Embedding model name
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Hardware & Performance Acceleration ────────
# Number of CPU threads to allocate for inference (set to 6 on 8-thread CPUs)
OLLAMA_NUM_THREADS=6

# Maximum tokens to generate per response (keeps answers concise & 2x faster)
OLLAMA_NUM_PREDICT=320

# Duration to keep model resident in RAM to eliminate reload delay (e.g., 24h, 1h)
OLLAMA_KEEP_ALIVE=24h

# ── RAG Settings ───────────────────────────────
# Request timeout for LLM calls (seconds)
LLM_REQUEST_TIMEOUT=300

# Number of top-k similar chunks to retrieve
RAG_SIMILARITY_TOP_K=3

# Chunk size and overlap for document indexing
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
