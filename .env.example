# ── Ollama Configuration ───────────────────────
# Base URL for the Ollama server (default: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# LLM model name (must be pulled via `ollama pull <model>`)
OLLAMA_LLM_MODEL=qwen2.5:3b

# Embedding model name
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── RAG Settings ───────────────────────────────
# Request timeout for LLM calls (seconds)
LLM_REQUEST_TIMEOUT=300

# Number of top-k similar chunks to retrieve
RAG_SIMILARITY_TOP_K=3

# Chunk size and overlap for document indexing
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=64
